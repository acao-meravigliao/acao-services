<div ...attributes>
{{#if @model}}
    Model: {{@model.constructor.modelName}}<br />
    <table class="table component raw-model-viewer">
      <tbody>
        {{#each-in this.attributes as |attr_name|}}
          <tr><td>{{attr_name}}</td><td>{{get @model attr_name}}</td></tr>
        {{/each-in}}
      </tbody>
    </table>
  {{else}}
    No model
  {{/if}}
</div>
