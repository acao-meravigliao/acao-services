{{page-title (t "authen.membership.renew.aircraft-new.page_title")}}

<section class="container section">
  <div class="buttons is-centered">
    Sei proprietario, comproprietario o utilizzatore di un
    {{if this.other_aircraft "altro mezzo?" "aliante o altro mezzo?"}}

    {{#unless this.another_aircraft}}
      <button class="button is-primary is-large" disabled={{this.form_invalid}} type="button"
              {{on "click" this.another_aircraft_yes_clicked}}>
        Sì
      </button>
      <button class="button is-warning is-large" disabled={{this.form_invalid}} type="button"
              {{on "click" this.another_aircraft_no_clicked}}>
        No
      </button>
    {{else}}
      <strong>Sì</strong>
    {{/unless}}
  </div>

  {{#if this.another_aircraft}}
    <div class="has-text-centered">
      {{#unless this.registration_entered}}
        <div class="field">
          <label class="label">Marche</label>
          <div class="control is-expanded">
            <input class="input"
                    type="text"
                    placeholder="D-1234"
                    value={{this.registration}}
                    {{on "input" this.registration_on_input}}
                    {{on "change" this.registration_on_change}}
            />
          </div>
        </div>

        {{#if this.aircraft}}
          Mezzo trovato:
            <strong>{{this.aircraft.registration}}
            {{#if this.aircraft.race_registration}}- {{this.aircraft.race_registration}}{{/if}}</strong><br />
          {{#if this.aircraft.aircraft_type}}
            Tipo: <strong>{{this.aircraft.aircraft_type.manufacturer}} - {{this.aircraft.aircraft_type.name}}</strong><br />
          {{/if}}
          {{#if this.aircraft.wingspan_computed}}
            Apertura alare: <strong>{{this.aircraft.wingspan_computed}} m</strong><br />
          {{/if}}
        {{else if this.registration}}
          Mezzo {{this.registration}} non trovato, verrà creato!<br />
        {{/if}}

        <button class="button is-primary" disabled={{not this.registration_ok_enabled}}
          {{on "click" this.registration_ok_clicked}}>Ok</button>
      {{else}}
        Marche: <strong>{{this.registration}}</strong><br />
        {{#if this.aircraft.aircraft_type}}
          Tipo: <strong>{{this.aircraft.aircraft_type.manufacturer}} - {{this.aircraft.aircraft_type.name}}</strong><br />
        {{/if}}
        {{#if this.aircraft.wingspan_computed}}
          Apertura alare: <strong>{{this.aircraft.wingspan_computed}} m</strong><br />
        {{/if}}
      {{/unless}}
    </div>

    {{#if this.registration_entered}}
      <div class="buttons is-centered">
        Sei proprietario di questo mezzo?

        {{#if this.role_confirmed}}
          <strong>{{if (eq this.role "OWNER") "Sì" "No"}}</strong>
        {{else}}
          <button class="button is-primary is-large" type="button" {{on "click" this.role_click_yes}}>
            Sì
          </button>
          <button class="button is-warning is-large" type="button" {{on "click" this.role_click_no}}>
            No
          </button>
        {{/if}}
      </div>
    {{/if}}

    {{#if this.role_confirmed}}
      <div class="buttons is-centered">
        Dove è ricoverato il mezzo?

        {{#if this.parking_confirmed}}
          <strong>{{this.parking_descr}}</strong>
        {{else}}
          <button class="button is-warning is-large" type="button" {{on "click" this.parking_click_a}}>
            Carrello Area A
          </button>
          <button class="button is-warning is-large" type="button" {{on "click" this.parking_click_bc}}>
            Carrello Area B/C
          </button>
          <button class="button is-primary is-large" type="button" {{on "click" this.parking_click_hangar}}>
            Hangar
          </button>
          <button class="button is-primary is-large" type="button" {{on "click" this.parking_click_other}}>
            Altrove
          </button>
        {{/if}}
      </div>
    {{/if}}
  {{/if}}

  <div class="buttons is-centered">
    <button class="button is-grey is-large" type="button" {{on "click" this.back}}>
      <span class="icon"><FaIcon @icon="backward" /></span>
      <span>Indietro</span>
    </button>
    {{#if this.parking_confirmed}}
      <button type="button" class="button is-warning is-large {{if this.submitting "is-loading"}}" {{on "click" this.submit}}>
        Avanti
      </button>
    {{/if}}
  </div>

  {{#if this.submit_error}}
    <ExceptionDecoder @ex={{this.submit_error}} as |title detail backtrace|>
      <div class="box notification is-danger">
        <h1 class="title">{{title}}</h1>
        <div>
          {{detail}}
        </div>
      </div>
    </ExceptionDecoder>
  {{/if}}
</section>
